[Unit]
Description=Remove expired Vimarx OAuth credentials from both isolated profiles
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vimarx-oauth-gateway
UMask=0077
ExecStartPre=/usr/bin/python3 /opt/vimarx-oauth-gateway/deploy/backup.py --prune
ExecStart=/usr/bin/python3 /opt/vimarx-oauth-gateway/deploy/cleanup.py
