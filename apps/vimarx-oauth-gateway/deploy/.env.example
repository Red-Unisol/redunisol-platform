APP_IMAGE=redunisol/vimarx-oauth-gateway:COMMIT_SHA
GATEWAY_ISSUER=https://mcp.redunisol.com.ar
VIMARX_ORIGIN=https://celesol.dyndns.org:35010
GATEWAY_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
