APP_IMAGE=redunisol/vimarx-oauth-gateway:COMMIT_SHA
GATEWAY_PROFILE=directory
GATEWAY_ISSUER=https://mcp.redunisol.com.ar/directorio
GATEWAY_ENV_FILE=../.env.directory
GATEWAY_PORT=3061
VIMARX_ORIGIN=https://celesol.dyndns.org:35010
GATEWAY_SECRET_KEY=REPLACE_WITH_OWN_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_OWN_FERNET_KEY
DATABASE_URL=sqlite:////data/gateway.db

# Same approved synthetic login may be used; every profile needs its own keys.
DEMO_ENABLED=0
DEMO_PASSWORD_HASH=
DEMO_TOKEN_KEY=REPLACE_WITH_OWN_DISTINCT_FERNET_KEY
