TARGET_DIR=/opt/metamap-platform-server-dev
COMPOSE_PROJECT_NAME=metamap-platform-server-dev
METAMAP_SERVER_DATABASE_URL=sqlite+pysqlite:////data/metamap_platform_server.db
METAMAP_SERVER_WEBHOOK_SECRET=change-me-webhook-secret
METAMAP_SERVER_BANK_CALLBACK_TOKEN=change-me-bank-callback-token
METAMAP_SERVER_METAMAP_CLIENT_ID=
METAMAP_SERVER_METAMAP_CLIENT_SECRET=
METAMAP_SERVER_METAMAP_API_TOKEN=
METAMAP_SERVER_METAMAP_AUTH_SCHEME=Token
METAMAP_SERVER_METAMAP_TIMEOUT_SECONDS=10
METAMAP_SERVER_METAMAP_MAX_ATTEMPTS=3
METAMAP_SERVER_METAMAP_RETRY_BACKOFF_SECONDS=0.5
METAMAP_SERVER_METAMAP_OAUTH_TOKEN_TTL_SECONDS=300
METAMAP_SERVER_ENRICHMENT_WORKERS=4
METAMAP_SERVER_ENRICHMENT_QUEUE_SIZE=200
METAMAP_SERVER_BOOTSTRAP_CLIENTS_JSON='[{"client_id":"validador-dev-1","client_secret":"change-me-validador","role":"validador","display_name":"Validador Dev 1"},{"client_id":"transferencias-dev-1","client_secret":"change-me-transferencias","role":"transferencias_celesol","display_name":"Transferencias Dev 1"}]'
