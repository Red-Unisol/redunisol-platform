{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "metamap-webhook-shadow",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://kestra.redunisol.com.ar/metamap-platform/api/v1/metamap/webhooks*",
      "zone_id": "98afdd42871695e66af52cec137d2be7"
    }
  ],
  "vars": { "SHADOW_CAPTURE_ENABLED": "true" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "queues": {
    "producers": [
      { "binding": "SHADOW_QUEUE", "queue": "metamap-webhook-shadow" }
    ],
    "consumers": [
      {
        "queue": "metamap-webhook-shadow",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 15,
        "dead_letter_queue": "metamap-webhook-shadow-dlq"
      }
    ]
  }
}
