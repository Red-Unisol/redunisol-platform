#!/usr/bin/python3
"""Capture and verify only the explicitly approved foundation configuration files."""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

ALLOWED_FILES = frozenset({{ foundation_backups_foundation_config_files | to_json }})
REVISION = {{ foundation_revision | default('unassigned') | to_json }}


def fingerprint(path):
    path = Path(path)
    if str(path) not in ALLOWED_FILES or path.resolve() != path:
        raise ValueError("Source is outside the approved canonical file catalog")
    before = path.lstat()
    if not stat.S_ISREG(before.st_mode):
        raise ValueError("Only regular nonsymlink configuration files are allowed")
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        opened = os.fstat(stream.fileno())
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            raise ValueError("Source changed while opening")
        for chunk in iter(lambda: stream.read(1048576), b""):
            digest.update(chunk)
        after = os.fstat(stream.fileno())
    fields = ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns",
              "st_mode", "st_uid", "st_gid")
    if any(getattr(before, name) != getattr(after, name) for name in fields):
        raise ValueError("Source changed during capture")
    return dict(path=str(path), sha256=digest.hexdigest(), size=after.st_size,
                mode=format(stat.S_IMODE(after.st_mode), "04o"),
                uid=after.st_uid, gid=after.st_gid)


def load_catalog(path):
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    if data.get("schema_version") != 1 or data.get("scope") != "foundation-config":
        raise ValueError("Unsupported source catalog")
    files = data.get("files")
    if not isinstance(files, list) or not files or len(files) > len(ALLOWED_FILES):
        raise ValueError("Invalid source catalog size")
    seen = set()
    for entry in files:
        if set(entry) != {"path", "sha256", "size", "mode", "uid", "gid"}:
            raise ValueError("Unexpected source catalog fields")
        name = entry["path"]
        if name not in ALLOWED_FILES or name in seen:
            raise ValueError("Unapproved or duplicate source catalog path")
        seen.add(name)
        if not re.fullmatch(r"[0-9a-f]{64}", entry["sha256"]):
            raise ValueError("Invalid source checksum")
        if not re.fullmatch(r"[0-7]{4}", entry["mode"]):
            raise ValueError("Invalid source mode")
        if any(type(entry[key]) is not int or entry[key] < 0 for key in ("size", "uid", "gid")):
            raise ValueError("Invalid source metadata")
    return data


def atomic_json(path, data):
    path = Path(path)
    with tempfile.NamedTemporaryFile(mode="w", dir=str(path.parent), delete=False,
                                     encoding="utf-8") as stream:
        temporary = stream.name
        os.chmod(temporary, 0o600)
        json.dump(data, stream, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)


def capture(output, paths):
    if not paths or len(paths) != len(set(paths)):
        raise ValueError("A nonempty unique source list is required")
    data = dict(schema_version=1, scope="foundation-config", revision=REVISION,
                files=[fingerprint(path) for path in sorted(paths)])
    atomic_json(output, data)


def verify(catalog_path, restored_root):
    catalog = load_catalog(catalog_path)
    root = Path(restored_root)
    if not root.is_dir() or root.is_symlink() or root.resolve() != root:
        raise ValueError("Restore target must be a canonical isolated directory")
    for entry in catalog["files"]:
        candidate = root / entry["path"].lstrip("/")
        if candidate.is_symlink() or not candidate.resolve().is_relative_to(root):
            raise ValueError("Restored path escapes the isolated target")
        info = candidate.lstat()
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("Restored configuration must be a regular file")
        digest = hashlib.sha256(candidate.read_bytes()).hexdigest()
        actual = (digest, info.st_size, format(stat.S_IMODE(info.st_mode), "04o"),
                  info.st_uid, info.st_gid)
        expected = tuple(entry[key] for key in ("sha256", "size", "mode", "uid", "gid"))
        if actual != expected:
            raise ValueError("Restored content or ownership/mode differs from the backed-up catalog")
    return catalog


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "capture" and len(sys.argv) >= 4:
        capture(sys.argv[2], sys.argv[3:])
    elif command == "compare" and len(sys.argv) == 4:
        if load_catalog(sys.argv[2]) != load_catalog(sys.argv[3]):
            raise ValueError("Source configuration changed during backup")
    elif command == "paths" and len(sys.argv) == 3:
        data = load_catalog(sys.argv[2])
        sys.stdout.buffer.write(b"".join(entry["path"].encode("utf-8") + b"\0" for entry in data["files"]))
    elif command == "verify" and len(sys.argv) == 4:
        verify(sys.argv[2], sys.argv[3])
    else:
        raise ValueError("Usage: backup-catalog capture OUTPUT SOURCE... | compare BEFORE AFTER | verify CATALOG ROOT")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, TypeError, json.JSONDecodeError) as error:
        print("Foundation source catalog validation failed: " + str(error), file=sys.stderr)
        raise SystemExit(1)
