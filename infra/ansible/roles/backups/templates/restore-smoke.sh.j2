#!/bin/bash
# Manual local fixture only: no real offsite repository or encryption key is used.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
readonly base={{ foundation_backups_restore_smoke_directory | quote }}
readonly metrics_dir={{ foundation_backups_textfile_directory | quote }}
readonly revision={{ foundation_revision | default('unassigned') | quote }}
if (( $# != 1 )); then
  printf 'Usage: restore-smoke --run-local-fixture\n' >&2; exit 64
fi
if [[ "$1" != --run-local-fixture ]]; then
  printf 'Creates a fresh local fixture/repository and retains evidence; does not test offsite recovery.\n' >&2; exit 64
fi
[[ -d "$base" && ! -L "$base" && "$(stat -c '%u' -- "$base")" == 0 && "$(stat -c '%a' -- "$base")" == 700 ]] || exit 78
run="$(mktemp -d -- "$base/run.XXXXXX")"
[[ "$run" == "$base/run."* ]] || exit 78
started="$(date +%s)"; snapshot_id=""
finish() {
  rc=$?
  trap - EXIT
  set +e
  /usr/bin/python3 - "$run" "$metrics_dir" "$started" "$(date +%s)" "$rc" "$revision" "$snapshot_id" <<'PY'
import json,os,pathlib,sys,tempfile
run,metrics,start,end,rc,revision,snapshot=sys.argv[1:];rc=int(rc);end=int(end)
data=dict(scope="local-fixture-only",started_at=int(start),finished_at=end,exit_code=rc,
          revision=revision,snapshot_id=snapshot or None,offsite_restore_tested=False)
pathlib.Path(run,"evidence.json").write_text(json.dumps(data,sort_keys=True)+"\n",encoding="utf-8")
path=pathlib.Path(metrics,"foundation-restore-smoke.prom")
with tempfile.NamedTemporaryFile(mode="w",dir=str(path.parent),delete=False,encoding="utf-8") as f:
    temp=f.name;os.chmod(temp,0o644)
    f.write("foundation_restore_smoke_local_only 1\nfoundation_restore_smoke_success {}\nfoundation_restore_smoke_last_attempt_timestamp_seconds {}\n".format(int(rc==0),start))
    if rc==0:f.write("foundation_restore_smoke_last_success_timestamp_seconds {}\n".format(end))
os.replace(temp,str(path))
PY
  evidence_rc=$?
  printf 'Local fixture restore finished: exit=%s; evidence retained in %s\n' "$rc" "$run"
  if (( rc == 0 && evidence_rc != 0 )); then exit "$evidence_rc"; fi
  exit "$rc"
}
trap finish EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
mkdir -m 0700 -- "$run/source" "$run/restore" "$run/cache"
unset RESTIC_PASSWORD RESTIC_PASSWORD_COMMAND RESTIC_REPOSITORY RESTIC_REPOSITORY_FILE
/usr/bin/python3 - "$run" "$revision" <<'PY'
import hashlib,pathlib,secrets,sys
run=pathlib.Path(sys.argv[1]);source=run/"source"
(run/"password").write_text(secrets.token_urlsafe(48)+"\n",encoding="utf-8")
(source/"alpha.txt").write_text("Red Unisol restore fixture\nrevision="+sys.argv[2]+"\n",encoding="utf-8")
(source/"payload.bin").write_bytes(secrets.token_bytes(16384))
lines=["{}  {}\n".format(hashlib.sha256(p.read_bytes()).hexdigest(),p.name)
       for p in sorted(source.iterdir())]
(source/"manifest.sha256").write_text("".join(lines),encoding="utf-8")
PY
common=(--repo "$run/repository" --password-file "$run/password" --cache-dir "$run/cache")
# The manual flag above authorizes init only for this unique fixture repository.
/usr/bin/restic "${common[@]}" init >"$run/restic.log" 2>&1
/usr/bin/restic "${common[@]}" backup --json --tag foundation-local-restore-fixture -- "$run/source" >"$run/backup.jsonl" 2>>"$run/restic.log"
snapshot_id="$(/usr/bin/python3 - "$run/backup.jsonl" <<'PY'
import json,re,sys
snapshot=""
for line in open(sys.argv[1],encoding="utf-8"):
    event=json.loads(line)
    if event.get("message_type")=="summary":snapshot=event.get("snapshot_id","")
if not re.fullmatch(r"[0-9a-f]{64}",snapshot):raise SystemExit(1)
print(snapshot)
PY
)"
/usr/bin/restic "${common[@]}" check --read-data >>"$run/restic.log" 2>&1
/usr/bin/restic "${common[@]}" restore "$snapshot_id" --target "$run/restore" --verify >>"$run/restic.log" 2>&1
restored="$run/restore$run/source"
[[ "$(readlink -f -- "$restored")" == "$run/restore/"* ]] || exit 78
cmp -- "$run/source/manifest.sha256" "$restored/manifest.sha256"
(cd -- "$restored"; sha256sum --check -- "$run/source/manifest.sha256") >"$run/verified.txt"
# Preserve the fixture repository, key, restored files and evidence; no auto-delete.
