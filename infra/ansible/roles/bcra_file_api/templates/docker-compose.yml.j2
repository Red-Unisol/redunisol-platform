---
services:
  bcra-file-api:
    image: {{ bcra_file_api_image | to_json }}
    container_name: redunisol-bcra-file-api
    restart: unless-stopped
    init: true
    read_only: true
    user: "10001:10001"
    stop_grace_period: 60s
    env_file:
      - path: ./api.env
        format: raw
    environment:
      BCRA_FILE_TERMS_ACCEPTED: {{ (bcra_file_api_terms_accepted | bool) | ternary('true', 'false') | to_json }}
      BCRA_FILE_DATA_DIR: /data
      BCRA_FILE_REFRESH_START_HOUR: "21"
      BCRA_FILE_REFRESH_END_HOUR: "7"
      BCRA_FILE_REFRESH_TIMEZONE: America/Argentina/Buenos_Aires
      BCRA_FILE_EXTENDED_ENABLED: "true"
      BCRA_FILE_MIN_FREE_BYTES: "21474836480"
      BCRA_FILE_MAX_BUILD_BYTES: "37580963840"
    volumes:
      - type: bind
        source: {{ bcra_file_api_data_dir | to_json }}
        target: /data
        bind:
          create_host_path: false
    tmpfs:
      - /tmp:size=64m,mode=1777
    ports:
      - "127.0.0.1:18082:8080"
    mem_limit: 2g
    cpus: 1.0
    pids_limit: 64
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    logging:
      driver: local
      options:
        max-size: "20m"
        max-file: "5"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).close()"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      io.redunisol.service: bcra-file-api
      io.redunisol.applied-revision: {{ bcra_file_api_revision | to_json }}
networks:
  default:
    name: redunisol-bcra-file-api
