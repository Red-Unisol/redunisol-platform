[Unit]
Description=Red Unisol CRM intake (inactive)

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=redunisol-crm-intake
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/redunisol-crm-intake/releases/{{ crm_intake_revision }}
Environment=CRM_INTAKE_REVISION={{ crm_intake_revision }}
Environment=CRM_INTAKE_STATUS_SOCKET=/run/redunisol-crm-intake/status.sock
ExecStart=/usr/bin/python3 -B -m crm_intake.server
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=96M
TasksMax=16

[Install]
WantedBy=multi-user.target
