# Managed by infra/ansible role metamap_origin.
[Unit]
Description=Isolated MetaMap HTTPS origin without application activation
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/apache2 -t -f {{ metamap_origin_config_dir }}/apache.conf
ExecStart=/usr/sbin/apache2 -f {{ metamap_origin_config_dir }}/apache.conf -DFOREGROUND
ExecReload=/usr/sbin/apache2 -f {{ metamap_origin_config_dir }}/apache.conf -k graceful
RuntimeDirectory=metamap-origin
RuntimeDirectoryMode=0755
UMask=0027
KillSignal=SIGWINCH
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ metamap_origin_runtime_dir }} {{ metamap_origin_log_dir }}

[Install]
WantedBy=multi-user.target
