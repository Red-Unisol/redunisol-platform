TARGET_DIR=/opt/redunisol-web-prod
WEB_BIND=127.0.0.1:3021:80

APP_NAME="Red Unisol"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://redunisol.com.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_DATABASE=redunisol_web_prod
DB_USERNAME=redunisol_web_prod
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=redunisol.com.ar

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
RECIBOS_DISK=s3
RECIBOS_TEMPORARY_URL_MINUTES=10080
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@redunisol.com.ar
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

KESTRA_FORM_WEBHOOK_URL=
GTM_ID=
GTM_AUTH=
GTM_PREVIEW=
VITE_TRACKING_DEBUG=
VITE_GA4_DEBUG=
KESTRA_FORM_WEBHOOK_TIMEOUT_SECONDS=60
KESTRA_FORM_DEFAULT_LEAD_SOURCE=Google

FINALIZAR_METAMAP_CLIENT_ID=
FINALIZAR_CAJA_API_BASE_URL=
FINALIZAR_FIAT_API_BASE_URL=
FINALIZAR_API_TIMEOUT_SECONDS=30
FINALIZAR_ITS_API_BASE_URL=
FINALIZAR_ITS_API_KEY=
FINALIZAR_ITS_API_USER=
FINALIZAR_ITS_API_PASSWORD=
FINALIZAR_ITS_API_TIMEOUT_SECONDS=25
