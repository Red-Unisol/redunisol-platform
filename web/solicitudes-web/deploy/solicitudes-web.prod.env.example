# ----------------------------------------------------------
# Deploy -- las usan el workflow y docker compose, no la aplicacion
#
# Los puertos tienen que ser distintos a los del ambiente de dev: los dos
# conviven en la misma VPS y no pueden escuchar en el mismo puerto.
# ----------------------------------------------------------
TARGET_DIR=/opt/solicitudes-web-prod
FRONTEND_BIND=127.0.0.1:3052:80
BACKEND_BIND=127.0.0.1:3053:3001

# ----------------------------------------------------------
# Aplicacion
# ----------------------------------------------------------
NODE_ENV=production
APP_NAME=Celesol

# Tiene que coincidir EXACTO con el dominio publico del frontend, o el
# navegador bloquea las llamadas por CORS.
APP_ORIGIN=https://solicitudes.ejemplo.com

# ----------------------------------------------------------
# Sesiones
# ----------------------------------------------------------
# Generar uno propio para este ambiente. Nunca reusar el de otro ambiente ni
# el que viene en celesol-backend/.env.example.
ACCESS_TOKEN_SECRET=generar-uno-nuevo-de-128-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_SEND_RATE_LIMIT_MAX=5
EMAIL_SEND_RATE_LIMIT_WINDOW_MINUTES=15

# ----------------------------------------------------------
# Sistema legado (Vimax / Fapi)
# ----------------------------------------------------------
# URL base de la API del sistema legado. Pedirla al responsable de
# infraestructura; el valor real vive solo en el .enc.
LEGACY_API_BASE_URL=https://host-del-legado:puerto
LEGACY_API_TIMEOUT_MS=10000

# ----------------------------------------------------------
# Adjuntos
# ----------------------------------------------------------
ADJUNTOS_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
ADJUNTOS_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ADJUNTOS_MAX_FILE_SIZE_BYTES=10485760

# ----------------------------------------------------------
# Object storage
#
# Con marcadores la aplicacion ARRANCA, pero subir un adjunto falla.
# ----------------------------------------------------------
MINIO_ENDPOINT=endpoint-del-bucket
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=reemplazar
MINIO_SECRET_KEY=reemplazar
MINIO_BUCKET_SOLICITUDES=nombre-del-bucket

# ----------------------------------------------------------
# Email -- SMTP de una casilla del hosting del dominio.
#
# SMTP_HOST: usar el nombre de servidor que muestre el panel de hosting,
# NO un alias tipo mail.<dominio>. El certificado SSL esta emitido para el
# nombre real del servidor; con un alias la validacion falla.
#
# SMTP_PORT: 465. email.service.ts decide si cifra con
# `secure: config.smtpPort === 465`. Con 587 abriria la conexion en claro
# y el servidor la corta.
#
# SMTP_USER y DEFAULT_MAIL_SENDER tienen que ser la misma direccion: el
# servidor rechaza remitentes distintos de la cuenta autenticada.
# ----------------------------------------------------------
MAIL_ENABLED=true
SMTP_HOST=servidor-smtp-del-panel
SMTP_PORT=465
SMTP_USER=noreply@ejemplo.com
SMTP_PASSWORD=reemplazar
DEFAULT_MAIL_SENDER=noreply@ejemplo.com

# ----------------------------------------------------------
# PostgreSQL -- contenedor y volumen propios, separados de los de dev
#
# La contrasena va dentro de la DATABASE_URL que arma el compose, asi que
# solo puede tener letras, numeros, guion y guion bajo. Un @ o un / la
# partirian en el lugar equivocado.
# ----------------------------------------------------------
POSTGRES_DB=solicitudes_web_prod
POSTGRES_USER=solicitudes_web_prod
POSTGRES_PASSWORD=generar-una-clave-fuerte
