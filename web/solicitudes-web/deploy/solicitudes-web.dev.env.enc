# ----------------------------------------------------------
# Object storage -- MinIO propio, solo para dev.
#
# Es un contenedor aparte del compose, creado a mano en la VPS y
# conectado a la red solicitudes-web-dev_default. No publica ningun
# puerto: solo se lo alcanza desde adentro de la red de Docker.
#
# MINIO_ENDPOINT es el NOMBRE DEL CONTENEDOR. Docker lo resuelve dentro
# de la red interna, igual que hace con "postgres" en el compose.
#
# MINIO_USE_SSL=false porque el trafico no sale de la maquina. Cifrarlo
# obligaria a certificados autofirmados sin ganar nada.
#
# Produccion NO usa esto: va a apuntar a un bucket de AWS S3 cuando se
# consigan las credenciales. La misma libreria sirve para los dos.
# ----------------------------------------------------------
MINIO_ENDPOINT=t5j3lSO6HtxLpBJNwHTbiTt9MPr-WG5FdtMDIZTOAGuEpEoibw==
MINIO_PORT=yqW4d51Evnhedfll9kAlDOXgFtI=
MINIO_USE_SSL=BGoRCaPLfEyD5nSLWMzKxtVMgmOS
MINIO_ACCESS_KEY=__SCmp_pvM-gucR4zXk2K7-gQw6-2j-Cn9KhEdQ3GA==
MINIO_SECRET_KEY=mgMpMbbKE4Ml21lWlhfMOoGOP9YJNbCRU7IQBVV0gcDsruqFyxnk9w==
