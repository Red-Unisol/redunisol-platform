# ----------------------------------------------------------
# Deploy -- las usan el workflow y docker compose, no la aplicacion
# ----------------------------------------------------------
TARGET_DIR=/opt/solicitudes-web-dev
FRONTEND_BIND=127.0.0.1:3050:80
BACKEND_BIND=127.0.0.1:3051:3001

# ----------------------------------------------------------
# Aplicacion
# ----------------------------------------------------------
NODE_ENV=production
APP_NAME=Celesol

# Tiene que coincidir EXACTO con el dominio publico del frontend, o el
# navegador bloquea las llamadas por CORS.
APP_ORIGIN=https://solicitudes.ejemplo.com

# ----------------------------------------------------------
# Sesiones
# ----------------------------------------------------------
# Generar uno nuevo por ambiente. Nunca reusar el de otro ambiente ni el que
# viene en celesol-backend/.env.example.
ACCESS_TOKEN_SECRET=generar-uno-nuevo-de-128-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL_SEND_RATE_LIMIT_MAX=5
EMAIL_SEND_RATE_LIMIT_WINDOW_MINUTES=15

# ----------------------------------------------------------
# Sistema legado (Vimax / Fapi)
# ----------------------------------------------------------
# URL base de la API del sistema legado. Pedirla al responsable de
# infraestructura; el valor real vive solo en el .enc.
LEGACY_API_BASE_URL=https://host-del-legado:puerto
LEGACY_API_TIMEOUT_MS=10000

# ----------------------------------------------------------
# Adjuntos
# ----------------------------------------------------------
ADJUNTOS_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
ADJUNTOS_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ADJUNTOS_MAX_FILE_SIZE_BYTES=10485760

# ----------------------------------------------------------
# Object storage -- PENDIENTE DE DEFINIR
#
# La decision es usar un bucket nuevo en la cuenta AWS S3 que ya usa
# redunisol-web, en vez de levantar un MinIO
# propio. Requiere hablar con quien administra esa cuenta.
#
# Con estos marcadores la aplicacion ARRANCA, pero subir un adjunto va a
# fallar. Es una limitacion conocida y aceptada hasta que se resuelva.
# ----------------------------------------------------------
MINIO_ENDPOINT=pendiente.definir
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=pendiente
MINIO_SECRET_KEY=pendiente
MINIO_BUCKET_SOLICITUDES=solicitudes-dev

# ----------------------------------------------------------
# Email -- SMTP de una casilla del hosting del dominio.
#
# SMTP_HOST: usar el nombre de servidor que muestre el panel de
# hosting, NO un alias tipo mail.<dominio>. El certificado SSL esta
# emitido para el nombre real del servidor; con un alias la
# validacion del certificado falla y la conexion se rechaza.
#
# SMTP_PORT: 465. email.service.ts decide si cifra con
# `secure: config.smtpPort === 465`. Con 587 abriria la conexion en
# claro y el servidor la corta.
#
# SMTP_USER y DEFAULT_MAIL_SENDER tienen que ser la misma direccion:
# el servidor rechaza mensajes cuyo remitente no sea la cuenta
# autenticada.
#
# Aunque MAIL_ENABLED sea false hay que definir las cuatro SMTP_*:
# el validador de arranque las exige igual.
# ----------------------------------------------------------
MAIL_ENABLED=true
SMTP_HOST=servidor-smtp-del-panel
SMTP_PORT=465
SMTP_USER=noreply@ejemplo.com
SMTP_PASSWORD=reemplazar
DEFAULT_MAIL_SENDER=noreply@ejemplo.com

# ----------------------------------------------------------
# PostgreSQL -- la base corre como contenedor en el mismo compose
# ----------------------------------------------------------
POSTGRES_DB=solicitudes_web_dev
POSTGRES_USER=solicitudes_web_dev
POSTGRES_PASSWORD=generar-una-clave-fuerte