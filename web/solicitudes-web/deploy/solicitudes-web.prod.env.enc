# ----------------------------------------------------------
# Email -- casilla noreply del hosting (panel Ferozo, cuenta c1650469).
#
# La misma casilla que dev: es del dominio, no del ambiente.
#
# SMTP_HOST: tiene que ser exactamente este nombre, NO
# mail.redunisol.com.ar. El certificado SSL del servidor esta emitido
# para vps-3028748-x.dattaweb.com; con cualquier otro nombre la
# validacion del certificado falla y la conexion se rechaza.
#
# SMTP_PORT: 465 no es opcional. email.service.ts decide si cifra con
# `secure: config.smtpPort === 465`. Con 587 abriria la conexion en
# claro y el servidor la corta.
#
# SMTP_USER y DEFAULT_MAIL_SENDER coinciden a proposito: el servidor
# rechaza mensajes cuyo remitente no sea la cuenta autenticada.
# ----------------------------------------------------------
MAIL_ENABLED=Z4ysDXKT-uMmPiUoPbQ0kb18jFw=
SMTP_HOST=7HkeCwcYw4T_DRNIhcT2iBV_1vO1fi8qrWYFOvmGdFJg5StHldscdF55
